{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud Mimir (Prometheus-compatible)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Grafana Cloud Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "logs",       "name": "Logs",       "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "RED dashboard — Task Manager on EKS (ingress-nginx v1.15.1). Rate from Prometheus, Errors + Latency from Loki log parsing. Built Day 45.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["eks", "taskmanager", "observability", "proops2026"],
  "time": { "from": "now-2d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Task Manager RED — EKS (Day 45)",
  "uid": "taskmanager-red-eks-d45",
  "version": 0,
  "panels": [

    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "description": "Aggregate nginx process requests per second. Uses nginx_ingress_controller_nginx_process_requests_total — the only available counter in ingress-nginx v1.15.x (VTS metrics removed).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(nginx_ingress_controller_nginx_process_requests_total[5m])",
          "legendFormat": "Requests/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(nginx_ingress_controller_nginx_process_connections_total{state=\"handled\"}[5m])",
          "legendFormat": "Connections handled/s",
          "refId": "B"
        }
      ]
    },

    {
      "id": 2,
      "title": "Error Rate — 4xx / 5xx (via Loki)",
      "description": "Error rate counted from nginx access log. ingress-nginx v1.15.x removed per-status Prometheus metrics — Loki log regex is the correct replacement pattern.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({namespace=\"ingress-nginx\"} |~ `\" [45][0-9]{2} ` [5m])) by (namespace)",
          "legendFormat": "4xx/5xx errors/s",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Avg Response Latency by Status (via Loki log parsing)",
      "description": "Latency extracted from nginx access log field 10 using LogQL pattern parser. Groups by HTTP status code. Works because nginx logs request duration even when Prometheus histograms are unavailable.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "avg_over_time(\n  {namespace=\"ingress-nginx\"}\n  | pattern `<_> - - [<_>] \"<method> <path> <_>\" <status> <_> \"<_>\" \"<_>\" <_> <duration> [<_>]`\n  | unwrap duration [5m]\n) by (status)",
          "legendFormat": "status={{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Nginx Error Logs (4xx / 5xx)",
      "description": "Raw nginx access log lines filtered to error status codes. This panel showed the AC-08 404 spike — 50 curl hits to /api/nonexistent-N on 2026-06-09.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{namespace=\"ingress-nginx\"} |~ `\" [45][0-9]{2} `",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Task Manager App Errors",
      "description": "Logs from all taskmanager pods filtered for 'error' keyword. Covers api-gateway, user-service, task-service, frontend-service.",
      "type": "logs",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{namespace=\"taskmanager\"} |= \"error\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }

  ]
}
